<Window x:Class="SegaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEGA+" Width="660" Height="470"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Loaded="Window_Loaded" Opacity="0">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Margin="16" CornerRadius="14" Background="{StaticResource Win}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="172"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- sidebar -->
            <Border Grid.Column="0" CornerRadius="14,0,0,14" Background="{StaticResource Side}">
                <DockPanel Margin="14,16,14,14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,16">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="SEGA+" Margin="9,0,0,0" Foreground="{StaticResource Text}"
                                   FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="LIBRARY" Foreground="{StaticResource Muted}"
                               FontSize="10" FontWeight="SemiBold" Margin="8,2,0,6"/>
                    <TextBlock x:Name="VersionLabel" DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}"
                               FontSize="11" Margin="8,8,0,0"/>
                    <ListBox x:Name="SourceList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SourceTab}" DisplayMemberPath="Name"
                             SelectionChanged="SourceList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>

            <!-- main -->
            <Grid Grid.Column="1">
                <!-- draggable title bar + window buttons -->
                <Grid VerticalAlignment="Top" Height="42" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0">
                        <Button Style="{StaticResource Chrome}" Content="&#8211;" Click="Min_Click"/>
                        <Button Style="{StaticResource ChromeClose}" Content="&#10005;" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <!-- content -->
                <Grid Margin="26,50,26,40">
                    <!-- update check -->
                    <StackPanel x:Name="CheckPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid Width="38" Height="38" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Ellipse Stroke="#3A3F41" StrokeThickness="3"/>
                            <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="3"
                                     StrokeDashArray="4 100" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRot"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SpinnerRot" Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:0.9"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="Checking for updates… please wait" Foreground="{StaticResource Muted}" FontSize="14"/>
                    </StackPanel>

                    <!-- update required -->
                    <StackPanel x:Name="UpdatePanel" Visibility="Collapsed" VerticalAlignment="Top">
                        <TextBlock Text="Update needed" Foreground="{StaticResource Accent}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="A newer version is required to continue. Grab the latest SEGA+ Installer, then reopen it."
                                   Foreground="{StaticResource Text}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,18"/>
                        <Button x:Name="DownloadButton" Style="{StaticResource RayPrimary}" Content="Get the latest version"
                                HorizontalAlignment="Left" Click="Download_Click"/>
                        <Button Style="{StaticResource Ghost}" Content="re-check" Click="Recheck_Click" Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- main flow -->
                    <StackPanel x:Name="MainPanel" Visibility="Collapsed" VerticalAlignment="Top">
                        <TextBlock x:Name="SourceName" Foreground="{StaticResource Text}" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DescText" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PlayButton" Grid.Column="0" Style="{StaticResource RayPrimary}"
                                    Content="&#9654;  Play" Click="Play_Click"/>
                            <Button x:Name="InstallButton" Grid.Column="2" Style="{StaticResource RaySecondary}"
                                    Content="&#11015;  Install source" Click="Install_Click"/>
                        </Grid>

                        <TextBlock x:Name="StatusText" Foreground="{StaticResource Text}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,20,0,0" MinHeight="44"/>
                    </StackPanel>
                </Grid>

                <!-- footer -->
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,18,12">
                    <TextBlock Text="credit: slowroads.io  " Foreground="{StaticResource Muted}" FontSize="11"/>
                    <TextBlock>
                        <Hyperlink NavigateUri="https://www.virustotal.com/"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{StaticResource Muted}">scan</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
