<Window x:Class="SegaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SEGA+" Height="480" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        FontFamily="Segoe UI" Background="{StaticResource Bg}"
        Loaded="Window_Loaded" Opacity="0">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid Margin="30,26,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SEGA+" Foreground="{StaticResource Text}" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="ON TOP" Foreground="{StaticResource Accent}" FontSize="28" FontWeight="Bold" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Members-only source code." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- content: overlapping panels -->
        <Grid Grid.Row="1">

            <!-- update check (shown first) -->
            <StackPanel x:Name="CheckPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Width="38" Height="38" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Ellipse Stroke="#3A3F41" StrokeThickness="3"/>
                    <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="3"
                             StrokeDashArray="4 100" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRot"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRot" Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:0.9"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
                <TextBlock Text="Checking for updates… please wait" Foreground="{StaticResource Muted}" FontSize="14"/>
            </StackPanel>

            <!-- update required -->
            <StackPanel x:Name="UpdatePanel" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock Text="Update needed" Foreground="{StaticResource Accent}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="A newer version is required to continue. Please grab the latest SEGA+ Installer, then reopen it."
                           Foreground="{StaticResource Text}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,18"/>
                <Button x:Name="DownloadButton" Style="{StaticResource Primary}" Content="Get the latest version" Click="Download_Click"/>
                <Button Style="{StaticResource Ghost}" Content="re-check" Click="Recheck_Click" Margin="0,12,0,0"/>
            </StackPanel>

            <!-- mode select -->
            <StackPanel x:Name="ModePanel" Visibility="Collapsed" VerticalAlignment="Top">
                <TextBlock Text="What do you want to do?" Foreground="{StaticResource Text}" FontSize="14" Margin="0,0,0,12"/>
                <Button Style="{StaticResource CardButton}" Click="PlayMode_Click" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="&#9654;  Play" Foreground="{StaticResource Text}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Run the game in your browser. Nothing is saved to disk." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CardButton}" Click="InstallMode_Click">
                    <StackPanel>
                        <TextBlock Text="&#11015;  Install source code" Foreground="{StaticResource Text}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Save the source code to a folder you choose." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- work panel -->
            <StackPanel x:Name="WorkPanel" Visibility="Collapsed" VerticalAlignment="Top">
                <Button Style="{StaticResource Ghost}" Content="&#8592;  back" Click="Back_Click" Margin="0,0,0,12"/>
                <TextBlock x:Name="WorkHeading" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Choose a source code:" Foreground="{StaticResource Text}" FontSize="13" Margin="0,16,0,5"/>
                <ComboBox x:Name="SourceCombo" DisplayMemberPath="Name" SelectionChanged="SourceCombo_SelectionChanged"/>
                <TextBlock x:Name="DescText" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Text}" FontSize="13" TextWrapping="Wrap" Margin="0,18,0,16" MinHeight="44"/>
                <Button x:Name="ActionButton" Style="{StaticResource Primary}" Content="Verify with Discord" Click="Action_Click"/>
            </StackPanel>
        </Grid>

        <!-- footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Full credit: slowroads.io.  " Foreground="{StaticResource Muted}" FontSize="11"/>
            <TextBlock>
                <Hyperlink NavigateUri="https://www.virustotal.com/"
                           RequestNavigate="Hyperlink_RequestNavigate"
                           Foreground="{StaticResource Muted}">scan this app</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
