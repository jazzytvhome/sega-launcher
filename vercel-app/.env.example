# Copy this file to ".env" and fill in real values.
# .env is gitignored — NEVER commit real secrets.
# Used by deploy.ps1 (pushes these to Vercel) and locally by `vercel dev`.

# --- Discord application (https://discord.com/developers/applications) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# --- SEGA+ server ---
# Developer Mode on → right-click the SEGA+ server icon → Copy Server ID
SEGA_GUILD_ID=

# --- Game decryption key (base64 AES-256) ---
# Generate with:  npm run keygen
# MUST be the SAME key you build game.enc with (package.ps1 -Key / npm run build:blob).
GAME_KEY=

# --- OPTIONAL: blacklist ---
# Comma-separated Discord user IDs to permanently reject (leave blank for none).
# e.g. BLACKLIST=111111111111111111,222222222222222222
BLACKLIST=
