# Copy this file to ".env" and fill in real values.
# .env is gitignored — NEVER commit real secrets.
# Used by deploy.ps1 (pushes these to Vercel) and locally by `vercel dev`.

# --- Discord application (https://discord.com/developers/applications) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# --- SEGA+ server ---
# Developer Mode on → right-click the SEGA+ server icon → Copy Server ID
SEGA_GUILD_ID=

# --- Game decryption key (base64 AES-256) ---
# Generate with:  npm run keygen
# MUST be the SAME key you build game.enc with (package.ps1 -Key / npm run build:blob).
GAME_KEY=

# --- OPTIONAL: blacklist ---
# Comma-separated Discord user IDs to permanently reject (leave blank for none).
# e.g. BLACKLIST=111111111111111111,222222222222222222
BLACKLIST=

# --- OPTIONAL: update gate ---
# When you ship a new launcher, set MIN_VERSION to that new version so older
# launchers show "update needed". DOWNLOAD_URL is where they get the new build
# (e.g. your SEGA+ Discord channel link). Leave MIN_VERSION blank to never force updates.
MIN_VERSION=
DOWNLOAD_URL=

# --- Weekly license token ---
LICENSE_SECRET=
LICENSE_DAYS=7

# --- Cloudflare R2 (presigned upload, no token to client) ---
# Create an R2 bucket and an API token with Object Read & Write on that bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sega-requests

# --- Staff Discord webhook (receives only the download link, not the file) ---
STAFF_WEBHOOK_URL=
